{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), xr-spatial-tracking=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
